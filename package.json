{
  "name": "zeabur-vscode",
  "displayName": "Zeabur",
  "description": "Deploy your current workspace to Zeabur with a single click.",
  "version": "0.2.5",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zeabur/vscode-extension"
  },
  "publisher": "zeabur",
  "icon": "images/zeabur.png",
  "activationEvents": [
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zeabur-sidebar",
          "title": "Zeabur",
          "icon": "images/zeabur.svg"
        }
      ]
    },
    "views": {
      "zeabur-sidebar": [
        {
          "id": "zeabur-deploy",
          "name": "Zeabur"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "pnpm run --parallel \"/^watch:/\"",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "pnpm run compile-tests && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/vscode": "^1.91.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.4.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.59.1"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "ignore": "^7.0.4"
  },
  "pnpm": {
    "overrides": {
      "cross-spawn": ">=7.0.5",
      "micromatch": ">=4.0.8",
      "picomatch": ">=2.3.2",
      "flatted": ">=3.4.2",
      "serialize-javascript": ">=7.0.5",
      "js-yaml": "^4.3.2",
      "diff": ">=5.2.2",
      "lodash": ">=4.18.0",
      "glob": ">=10.5.0",
      "minimatch": ">=9.0.7",
      "brace-expansion": ">=5.0.12"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
